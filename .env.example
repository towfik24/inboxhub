# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metainbox_saas?schema=public"

# NextAuth Authentication
NEXTAUTH_SECRET="your_nextauth_jwt_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# Meta (Facebook / Instagram) Graph API & Webhooks
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="metainbox_verify_token_secure"

# Real-time WebSocket (Pusher)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# Payment Gateway (SSLCommerz / bKash / Nagad)
SSLCOMMERZ_IS_LIVE="false"
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="testbox@ssl"
